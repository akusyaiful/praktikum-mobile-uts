<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PEMESANAN TIKET SEMINAR"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Silakan isi formulir pemesanan tiket"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Pemesan"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan nama lengkap"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kategori Tiket"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <RadioGroup
            android:id="@+id/rgKategori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbInternal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mahasiswa Internal - Rp50.000" />

            <RadioButton
                android:id="@+id/rbEksternal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mahasiswa Eksternal - Rp75.000" />

            <RadioButton
                android:id="@+id/rbDosen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dosen/Tenaga Kependidikan - Rp100.000" />

            <RadioButton
                android:id="@+id/rbUmum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Umum - Rp150.000" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jumlah Tiket"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etJumlah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan jumlah tiket"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jumlah Pembayaran (Rp)"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etPembayaran"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan jumlah pembayaran"
            android:inputType="number" />

        <Button
            android:id="@+id/btnHitung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HITUNG PEMBAYARAN"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESET FORMULIR" />

        <TextView
            android:id="@+id/tvHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hasil transaksi akan ditampilkan di sini."
            android:textSize="15sp"
            android:padding="16dp"
            android:background="#EEEEEE"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>
